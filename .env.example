# ==============================================================================
# AWS Student Builder Group - Financial Manager Environment Variables
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Database Configuration (PostgreSQL 16)
# ------------------------------------------------------------------------------
POSTGRES_DB=finance_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres123
POSTGRES_PORT=5432

# ------------------------------------------------------------------------------
# 2. Spring Boot & Security Configuration
# ------------------------------------------------------------------------------
SPRING_PROFILES_ACTIVE=prod
# Generate a secure 256-bit+ HMAC-SHA256 hex/base64 key:
JWT_SECRET=replace_this_with_a_super_secure_random_256_bit_secret_key_1234567890
# Token expiration in milliseconds (default: 86400000 = 24 hours)
JWT_EXPIRATION_MS=86400000

# ------------------------------------------------------------------------------
# 3. Google OAuth 2.0 Authentication
# ------------------------------------------------------------------------------
# Obtain from Google Cloud Console -> APIs & Services -> Credentials -> OAuth 2.0 Client IDs
GOOGLE_CLIENT_ID=270889581394-8snua48fsgd0t7fbfbhstrh2jfbjho14.apps.googleusercontent.com

# ------------------------------------------------------------------------------
# 4. Storage Configuration (Receipts & Invoices / Comprovantes)
# ------------------------------------------------------------------------------
# Options: 'local' (stores inside container/EBS volume) or 's3' (AWS S3 Bucket)
STORAGE_TYPE=s3

# AWS S3 Settings (required only if STORAGE_TYPE=s3)
AWS_S3_BUCKET_NAME=aws-sbg-finance-comprovantes-2026
AWS_REGION=us-east-2
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# ------------------------------------------------------------------------------
# 5. Application & CORS Settings
# ------------------------------------------------------------------------------
CORS_ALLOWED_ORIGINS=https://aws-sbg-finance.duckdns.org,http://aws-sbg-finance.duckdns.org,http://localhost,http://localhost:80,http://localhost:4200,*

# First user with this email who logs in via Google will automatically receive ADMIN role:
INITIAL_ADMIN_EMAIL=studentbuildergroup@gmail.com

# ------------------------------------------------------------------------------
# 6. Email Notification Settings (SMTP)
# ------------------------------------------------------------------------------
SPRING_MAIL_HOST=smtp.gmail.com
SPRING_MAIL_PORT=587
SPRING_MAIL_USERNAME=studentbuildergroup@gmail.com
# Google App Password (senha de aplicativo de 16 letras gerada na Conta Google):
SPRING_MAIL_PASSWORD=

# Ports exposed
FRONTEND_PORT=80
BACKEND_PORT=8080
